+// glthread runs the driver work on a separate thread. It is opt-in with the
+// MESA_GLTHREAD environment variable (set it before the context is bound).
+static bool
+switch_glthread_wanted(void)
+{
+    const char *value = getenv("MESA_GLTHREAD");
+    return value && strcmp(value, "0") != 0 && strcmp(value, "false") != 0;
+}
+
+static struct gl_context *
+switch_gl_context(struct st_context_iface *stctx)
+{
+    return stctx ? ((struct st_context *)stctx)->ctx : NULL;
+}
