+/* Freed textures leave their buffer objects in a small cache, from which
+ * new textures of the same size and layout take them once the GPU is done
+ * with the old texture. Creating a buffer object takes several calls into
+ * the GPU driver on the Switch, and the game streams in and frees textures
+ * of the same few sizes all the time. */
+static void
+nvc0_tex_bo_cache_release(struct nvc0_tex_bo_cache_entry *entry)
+{
+   if (entry->fence && entry->fence->state < NOUVEAU_FENCE_STATE_FLUSHED)
+      nouveau_fence_work(entry->fence, nouveau_fence_unref_bo, entry->bo);
+   else
+      nouveau_bo_ref(NULL, &entry->bo);
+   nouveau_fence_ref(NULL, &entry->fence);
+}
+
+static void
+nvc0_tex_bo_cache_remove(struct nvc0_screen *screen, unsigned i)
+{
+   screen->tex_bo_cache.bytes -= screen->tex_bo_cache.entry[i].size;
+   screen->tex_bo_cache.count--;
+   memmove(&screen->tex_bo_cache.entry[i], &screen->tex_bo_cache.entry[i + 1],
+           (screen->tex_bo_cache.count - i) *
+           sizeof(struct nvc0_tex_bo_cache_entry));
+}
+
+void
+nvc0_tex_bo_cache_flush(struct nvc0_screen *screen)
+{
+   while (screen->tex_bo_cache.count) {
+      nvc0_tex_bo_cache_release(&screen->tex_bo_cache.entry[0]);
+      nvc0_tex_bo_cache_remove(screen, 0);
+   }
+}
+
+static struct nouveau_bo *
+nvc0_tex_bo_cache_get(struct nvc0_screen *screen, uint32_t size,
+                      uint32_t flags, const union nouveau_bo_config *config)
+{
+   struct nouveau_bo *bo;
+   int i;
+
+   for (i = screen->tex_bo_cache.count - 1; i >= 0; --i) {
+      struct nvc0_tex_bo_cache_entry *entry = &screen->tex_bo_cache.entry[i];
+
+      if (entry->size != size || entry->flags != flags ||
+          entry->memtype != config->nvc0.memtype ||
+          entry->tile_mode != config->nvc0.tile_mode)
+         continue;
+      if (entry->fence && !nouveau_fence_signalled(entry->fence))
+         continue;
+
+      bo = entry->bo;
+      nouveau_fence_ref(NULL, &entry->fence);
+      nvc0_tex_bo_cache_remove(screen, i);
+      return bo;
+   }
+   return NULL;
+}
+
+static bool
+nvc0_tex_bo_cache_put(struct pipe_screen *pscreen, struct nv50_miptree *mt)
+{
+   struct nvc0_screen *screen = nvc0_screen(pscreen);
+   struct nvc0_tex_bo_cache_entry *entry;
+   const unsigned shared = PIPE_BIND_SHARED | PIPE_BIND_SCANOUT |
+      PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_CURSOR;
+   const bool compressed = nouveau_screen(pscreen)->drm->version >= 0x01000101;
+
+   if (!mt->base.bo || (mt->base.base.bind & shared) ||
+       (mt->base.base.flags & NVC0_RESOURCE_FLAG_VIDEO) ||
+       mt->total_size > NVC0_TEX_BO_CACHE_BYTES / 4)
+      return false;
+
+   while (screen->tex_bo_cache.count == NVC0_TEX_BO_CACHE_ENTRIES ||
+          screen->tex_bo_cache.bytes + mt->total_size > NVC0_TEX_BO_CACHE_BYTES) {
+      nvc0_tex_bo_cache_release(&screen->tex_bo_cache.entry[0]);
+      nvc0_tex_bo_cache_remove(screen, 0);
+   }
+
+   /* The same key that nvc0_miptree_create computes for the texture */
+   entry = &screen->tex_bo_cache.entry[screen->tex_bo_cache.count++];
+   entry->bo = mt->base.bo;
+   entry->fence = NULL;
+   nouveau_fence_ref(mt->base.fence, &entry->fence);
+   entry->size = mt->total_size;
+   entry->flags = mt->base.domain | NOUVEAU_BO_NOSNOOP;
+   entry->memtype = nvc0_mt_choose_storage_type(mt, compressed);
+   entry->tile_mode = mt->level[0].tile_mode;
+   screen->tex_bo_cache.bytes += mt->total_size;
+   mt->base.bo = NULL;
+   return true;
+}
+
+static void
+nvc0_miptree_destroy(struct pipe_screen *pscreen, struct pipe_resource *pt)
+{
+   struct nv50_miptree *mt = nv50_miptree(pt);
+
+   if (!nvc0_tex_bo_cache_put(pscreen, mt)) {
+      nv50_miptree_destroy(pscreen, pt);
+      return;
+   }
+
+   nouveau_fence_ref(NULL, &mt->base.fence);
+   nouveau_fence_ref(NULL, &mt->base.fence_wr);
+
+   NOUVEAU_DRV_STAT(nouveau_screen(pscreen), tex_obj_current_count, -1);
+   NOUVEAU_DRV_STAT(nouveau_screen(pscreen), tex_obj_current_bytes,
+                    -(uint64_t)mt->total_size);
+
+   FREE(mt);
+}
+
