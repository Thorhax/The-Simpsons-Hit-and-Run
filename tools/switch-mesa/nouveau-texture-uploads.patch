+static void
+nvc0_transfer_release_staging(struct nvc0_context *nvc0,
+                              struct nvc0_transfer *tx)
+{
+   struct nouveau_fence *fence = nvc0->screen->base.fence.current;
+
+   if (tx->mm) {
+      nouveau_bo_ref(NULL, &tx->rect[1].bo);
+      nouveau_fence_work(fence, nouveau_mm_free_work, tx->mm);
+      tx->mm = NULL;
+   } else {
+      /* Too large for the slab cache, so it got its own buffer object */
+      nouveau_fence_work(fence, nouveau_fence_unref_bo, tx->rect[1].bo);
+      tx->rect[1].bo = NULL;
+   }
+}
